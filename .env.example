# Copy to .env and fill in. Never commit .env.
# Each practical adds its settings below; docs/<practical>.md lists the new ones.

GOOGLE_API_KEY=

# --- triage ---

# Model as "<provider>:<model id>" (LangChain init_chat_model format).
# Check current model ids and free-tier limits before changing:
# https://ai.dev/rate-limit
ASSISTANT_MODEL=google_genai:gemini-3.5-flash-lite

# Variant 2 only: the stronger model to compare with. Its free-tier daily
# limit is small, so read the run rules in the assignment first.
# ASSISTANT_MODEL=google_genai:gemini-3.8-flash

# Version of the system instructions: the file prompts/<version>.md.
PROMPT_VERSION=v1

# A timeout in seconds and a bounded number of retries per call.
# MODEL_TIMEOUT=
# MODEL_MAX_RETRIES=

# Variant 2: prices in USD per 1M tokens from the provider's pricing page.
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=
